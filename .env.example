# Copy to .env and fill in. Never commit .env.

# Google AI Studio API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Google Cloud project that hosts Firestore / Cloud Run
GOOGLE_CLOUD_PROJECT=

# Optional overrides
# GEMINI_MODEL=gemini-flash-lite-latest       # primary (gemini-flash-latest allows only 20 free requests a day)
# GEMINI_FALLBACK_MODEL=gemini-flash-latest   # used if the primary fails; set empty to disable
# AUTO_INVESTIGATE=true          # false = Gemini investigates only when an analyst asks
# CORS_ORIGINS=http://localhost:5173
# STORE_BACKEND=firestore        # or "memory" (nothing saved; default when no project is set)
# SEED_ON_START=false            # with STORE_BACKEND=memory: load the demo customers at startup
# SAFETY_PAUSE_SECONDS=120       # cooling-off period, shortened for the demo
# ADMIN_TOKEN=                   # any long random string; enables POST /admin/reset (used by scripts/demo.py reset)
